# Build artifacts. The target dir normally lives on the internal disk
# (.cargo/config.toml), but a stale one can appear here.
/target/
/dist/

# Generated by ./configure and by make.
/Makefile
/Makefile.tmp*
/packaging/MANIFEST

# Generated by the audit targets.
/audit/

# Exported conversation transcripts. These have carried credentials in the
# past, so they are excluded by shape rather than by remembering each time.
*-this-session-*.txt
/*.txt

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Archives produced by `make dist`.
*.tar
*.tar.gz
*.tar.xz
